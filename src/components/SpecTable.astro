---
// Two-column spec table in mono with hairlines. rows: [[term, value]].
const { rows = [] } = Astro.props;
---
<dl class="spec mono">
  {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
</dl>
<style>
  .spec{margin:0;font-family:var(--mono);font-size:var(--t-xs)}
  .spec div{display:grid;grid-template-columns:1fr 1.4fr;gap:24px;padding:14px 0;border-top:1px solid var(--line)}
  .spec div:last-child{border-bottom:1px solid var(--line)}
  dt{color:var(--ink-soft);margin:0}
  dd{margin:0}
</style>
