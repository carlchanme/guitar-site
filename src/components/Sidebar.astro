---
import { pathway, phases, dayHref, phaseProgress, pathwayProgress, dayProgress } from "../lib/course.js";
import StatusIcon from "./StatusIcon.astro";
const { activeDay = null } = Astro.props;
const total = pathwayProgress();
const path = Astro.url.pathname;
---
<aside class="side" id="side">
  <div class="path">
    <strong>{pathway.title}</strong>
    <span class="mono">{total.done}/{total.total} days</span>
  </div>

  <nav class="quick">
    <a href="/path/" class={path.startsWith("/path") ? "on" : ""}>Path</a>
    <a href="/progress/" class={path.startsWith("/progress") ? "on" : ""}>Progress</a>
  </nav>

  {phases.map((p) => {
    const pp = phaseProgress(p);
    const open = p.days.some((d) => d.day === activeDay) || (activeDay == null && p.status === "current");
    return (
      <details class={"phase " + p.status} open={open}>
        <summary>
          <div>
            <b>{p.name} · {p.title}</b>
            <span><span class="mono">{p.weeks}</span> · <span class="mono">{pp.done}/{pp.total}</span> days</span>
          </div>
          <StatusIcon status={p.status} size={20} />
        </summary>
        <i class="bar"><b style={`width:${pp.pct}%`}></b></i>
        {p.days.length > 0 ? (
          <ol class="days">
            {p.days.map((d) => {
              const dp = dayProgress(d);
              return (
                <li class={(d.day === activeDay ? "on " : "") + d.status}>
                  <a href={dayHref(d)}>
                    <span class="n mono">{String(d.day).padStart(2, "0")}</span>
                    <span class="t">{d.title}</span>
                    {d.status === "current" && dp.done > 0
                      ? <svg class="ring" width="20" height="20" viewBox="0 0 22 22" aria-label="in progress" role="img"><circle cx="11" cy="11" r="9" fill="none" stroke="var(--line)" stroke-width="2"/><circle cx="11" cy="11" r="9" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray={`${(dp.pct / 100) * 56.5} 56.5`} transform="rotate(-90 11 11)" stroke-linecap="round"/></svg>
                      : <StatusIcon status={d.status} size={20} />}
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="locked-note">{p.plannedDays} days. Written after the Phase {phases.indexOf(p)} gate passes. Outcome: {p.outcome}</p>
        )}
      </details>
    );
  })}
</aside>

<style>
  .side{background:var(--surface);border-right:1px solid var(--line);padding:24px 20px 48px;overflow-y:auto}
  .path{margin:0 0 20px}
  .path strong{display:block;font-family:var(--display);font-variation-settings:"SOFT" 50,"WONK" 0;font-weight:500;font-size:var(--t-md);line-height:1.2;letter-spacing:var(--track-tight)}
  .path span{display:block;color:var(--ink-soft);margin-top:4px}
  .quick{display:flex;gap:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:8px}
  .quick a{padding:10px 0;text-decoration:none;color:var(--ink-soft);font-size:var(--t-xs);transition:opacity 150ms}
  .quick a:hover{opacity:.8}
  .quick a.on{color:var(--ink);font-weight:700;opacity:1}
  .phase{border-bottom:1px solid var(--line)}
  .phase summary{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 0;cursor:pointer;list-style:none}
  .phase summary::-webkit-details-marker{display:none}
  .phase summary b{display:block;font-size:var(--t-xs);color:var(--ink);font-weight:700}
  .phase.locked summary b{color:var(--ink-faint)}
  .phase summary > div > span{display:block;font-size:var(--t-xs);color:var(--ink-soft)}
  .bar{display:block;height:1px;background:var(--line);margin:0 0 8px}
  .bar b{display:block;height:100%;background:var(--ink-soft)}
  .days{list-style:none;padding:0;margin:0 0 12px;display:flex;flex-direction:column}
  .days a{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);min-height:44px;padding:6px 8px 6px 0;border-radius:var(--radius);transition:opacity 150ms}
  .days a:hover{opacity:.8}
  .days .n{flex:none;width:24px;color:var(--ink-faint)}
  .days .t{flex:1;min-width:0;font-size:var(--t-xs);line-height:1.3}
  .days li.on a{background:var(--card);padding-left:8px;margin-left:-8px;opacity:1}
  .days li.on .t{font-weight:700}
  .days li.on .n{color:var(--ink)}
  .days li.locked a{color:var(--ink-faint)}
  .locked-note{font-size:var(--t-xs);color:var(--ink-faint);margin:0 0 14px}
</style>
