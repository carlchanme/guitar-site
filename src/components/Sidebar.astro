---
import { pathway, phases, dayHref, phaseProgress, pathwayProgress, dayProgress } from "../lib/course.js";
import StatusIcon from "./StatusIcon.astro";
const { activeDay = null } = Astro.props;
const total = pathwayProgress();
---
<aside class="side" id="side">
  <div class="path">
    <div class="art" aria-hidden="true"></div>
    <div>
      <strong>{pathway.title}</strong>
      <span>{pathway.subtitle} · {total.done}/{total.total} days</span>
    </div>
  </div>

  <nav class="quick">
    <a href="/" class={Astro.url.pathname === "/" ? "on" : ""}>Overview</a>
    <a href="/progress/" class={Astro.url.pathname.startsWith("/progress") ? "on" : ""}>Progress</a>
  </nav>

  {phases.map((p) => {
    const pp = phaseProgress(p);
    const open = p.days.some((d) => d.day === activeDay) || (activeDay == null && p.status === "current");
    return (
      <details class={"phase " + p.status} open={open}>
        <summary>
          <div>
            <b>{p.name} · {p.title}</b>
            <span>{p.weeks} · {pp.done}/{pp.total} days</span>
          </div>
          <StatusIcon status={p.status} size={20} />
        </summary>
        <i class="bar"><b style={`width:${pp.pct}%`}></b></i>
        {p.days.length > 0 ? (
          <ol class="days">
            {p.days.map((d) => {
              const dp = dayProgress(d);
              return (
                <li class={(d.day === activeDay ? "on " : "") + d.status}>
                  <a href={dayHref(d)}>
                    <span class="n">Day {d.day}</span>
                    <span class="t">{d.title}</span>
                    {d.status === "current" && dp.done > 0
                      ? <svg class="ring" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="9" fill="none" stroke="var(--line)" stroke-width="2"/><circle cx="11" cy="11" r="9" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray={`${(dp.pct / 100) * 56.5} 56.5`} transform="rotate(-90 11 11)" stroke-linecap="round"/></svg>
                      : <StatusIcon status={d.status} />}
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="locked-note">{p.plannedDays} days. Written after the Phase {phases.indexOf(p)} gate passes. Outcome: {p.outcome}</p>
        )}
      </details>
    );
  })}
</aside>

<style>
  .side{background:var(--panel);border-right:1px solid var(--line);padding:18px 14px 40px;overflow-y:auto}
  .path{display:flex;gap:12px;align-items:center;margin:0 4px 14px}
  .art{width:48px;height:48px;border-radius:10px;flex:none;
    background:linear-gradient(135deg,var(--accent),#5a2d0c)}
  .path strong{display:block;font-size:15px;line-height:1.25}
  .path span{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .quick{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
  .quick a{padding:11px 14px;text-decoration:none;color:var(--ink);font-size:14px;border-bottom:1px solid var(--line)}
  .quick a:last-child{border-bottom:0}
  .quick a.on{color:var(--accent)}
  .phase{background:var(--card);border:1px solid var(--line);border-radius:12px;margin-bottom:10px;padding:0 14px}
  .phase summary{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;cursor:pointer;list-style:none}
  .phase summary::-webkit-details-marker{display:none}
  .phase summary b{display:block;font-size:14px;color:var(--accent);font-weight:600}
  .phase.locked summary b{color:var(--muted)}
  .phase summary span{display:block;font-size:12px;color:var(--muted)}
  .bar{display:block;height:2px;background:var(--line);margin:0 0 6px}
  .bar b{display:block;height:100%;background:var(--accent)}
  .days{list-style:none;padding:0;margin:6px 0 12px;display:flex;flex-direction:column;gap:6px}
  .days a{display:flex;align-items:center;gap:0;background:var(--bg);border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--ink);overflow:hidden;min-height:52px}
  .days .n{flex:none;width:66px;align-self:stretch;display:flex;align-items:center;justify-content:center;background:var(--panel);font-size:13px;font-weight:600}
  .days .t{flex:1;padding:8px 10px;font-size:14px;line-height:1.3}
  .days a > :global(svg){margin-right:12px}
  .days li.on a{border-color:var(--accent)}
  .days li.locked a{opacity:.55}
  .locked-note{font-size:13px;color:var(--muted);margin:0 0 12px}
</style>
