---
// The one action primitive. variant: "primary" (the single accent action on a
// screen) · "link" (text link, underline on hover/focus only) · default
// (secondary). Renders <a> when href is given, else <button>. Extra attributes
// (data-*, id, aria-*) pass through so page scripts can hook them.
const { variant, href, disabled = false, class: extra = "", ...rest } = Astro.props;
const cls = ["action", variant, extra].filter(Boolean).join(" ");
---
{href
  ? <a href={href} class={cls} {...rest}><slot /></a>
  : <button class={cls} disabled={disabled} aria-disabled={disabled ? "true" : undefined} {...rest}><slot /></button>}
<style>
  .action{display:inline-flex;align-items:center;gap:8px;font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:10px 14px;min-height:44px;cursor:pointer;text-decoration:none;touch-action:manipulation;transition:opacity 150ms}
  .action:hover{opacity:.85}
  .primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700}
  .action[disabled],.action[aria-disabled="true"]{opacity:.4;cursor:not-allowed;pointer-events:none}
  .link{background:none;border:0;padding:0;min-height:0;color:var(--ink);text-decoration:none;text-underline-offset:3px;text-decoration-thickness:1px}
  .link:hover,.link:focus-visible{text-decoration:underline;opacity:1}
</style>
