---
// Sticky session runner. blocks: [{ id, title, minutes, bpm?, subdiv? }]
// Each block id must match a <Block id=...> on the page. When a block has a
// bpm, the runner starts that block's metronome; when it has none, it stops
// whatever is clicking.
const { blocks } = Astro.props;
const total = blocks.reduce((a, b) => a + b.minutes, 0);
---
<div class="session" data-session data-blocks={JSON.stringify(blocks)}>
  <div class="line">
    <div class="now"><span data-title>Session · {total} min</span><small data-sub>{blocks.map((b) => b.minutes).join(" · ")}</small></div>
    <div class="clock" data-clock>{String(blocks[0].minutes).padStart(2, "0")}:00</div>
  </div>
  <div class="ctl">
    <button class="primary" data-start>Start session</button>
    <button data-skip hidden>Next block</button>
    <button data-reset hidden>Reset</button>
  </div>
  <div class="bar"><i data-bar></i></div>
</div>

<style>
  .session{position:sticky;top:0;z-index:5;background:var(--bg);padding:10px 0 8px;margin:0 0 6px;border-bottom:1px solid var(--rule)}
  .line{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .now{min-width:0}
  .now span{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .now small{display:block;color:var(--muted);font-size:13px}
  .clock{font-size:40px;line-height:1;font-variant-numeric:tabular-nums;font-weight:600}
  .ctl{display:flex;gap:8px;margin-top:8px}
  .ctl button{flex:1}
  .bar{height:4px;background:#c9c3b5;border-radius:2px;margin-top:8px;overflow:hidden}
  .bar i{display:block;height:100%;width:0;background:var(--root);transition:width .5s linear}
  .session.done .clock{color:var(--ok)}
</style>

<script>
  type B = { id: string; title: string; minutes: number; bpm?: number; subdiv?: number };
  for (const root of document.querySelectorAll<HTMLElement>("[data-session]")) {
    const blocks: B[] = JSON.parse(root.dataset.blocks!);
    const total = blocks.reduce((a, b) => a + b.minutes, 0);
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    let i = -1, endAt = 0, timer: number | null = null;

    const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;

    function beep(n: number) {
      const gm = (window as any).gm;
      if (!gm?.ctx) return;
      for (let k = 0; k < n; k++) {
        const t = gm.ctx.currentTime + k * 0.18;
        const o = gm.ctx.createOscillator(), g = gm.ctx.createGain();
        o.frequency.value = 660; g.gain.setValueAtTime(0.6, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
        o.connect(g).connect(gm.ctx.destination); o.start(t); o.stop(t + 0.16);
      }
    }

    function show(sec: number) {
      $("[data-clock]").textContent = fmt(sec);
      const done = blocks.slice(0, i).reduce((a, b) => a + b.minutes * 60, 0) + blocks[i].minutes * 60 - sec;
      $("[data-bar]").style.width = `${(done / (total * 60)) * 100}%`;
    }

    function enter(n: number) {
      i = n;
      document.querySelectorAll(".block.on").forEach((b) => b.classList.remove("on"));
      const b = blocks[i];
      const sec = document.getElementById("block-" + b.id);
      sec?.classList.add("on");
      sec?.scrollIntoView({ behavior: "smooth", block: "start" });
      $("[data-title]").textContent = `${i + 1}/${blocks.length} · ${b.title}`;
      $("[data-sub]").textContent = b.bpm ? `${b.minutes} min · ${b.bpm} BPM × ${b.subdiv ?? 1}` : `${b.minutes} min`;
      const m = sec?.querySelector<HTMLElement>("[data-metronome]");
      if (b.bpm && m) (window as any).gmPreset?.(m, b.bpm, b.subdiv ?? 1, true);
      else (window as any).gmStop?.();
      endAt = Date.now() + b.minutes * 60000;
      show(b.minutes * 60);
      if (timer) clearInterval(timer);
      timer = window.setInterval(() => {
        const left = Math.max(0, Math.round((endAt - Date.now()) / 1000));
        show(left);
        if (left === 0) { beep(3); i + 1 < blocks.length ? enter(i + 1) : finish(); }
      }, 250);
    }

    function finish() {
      if (timer) clearInterval(timer);
      timer = null;
      (window as any).gmStop?.();
      root.classList.add("done");
      $("[data-title]").textContent = "Session done. Log it.";
      $("[data-sub]").textContent = `${total} min`;
      $("[data-bar]").style.width = "100%";
      $("[data-start]").hidden = true; $("[data-skip]").hidden = true; $("[data-reset]").hidden = false;
    }

    $("[data-start]").addEventListener("click", () => {
      // First gesture on the page: open the audio context so later clicks are allowed.
      const w = window as any;
      if (!w.gm?.ctx) { const A = w.AudioContext || w.webkitAudioContext; if (A && w.gm) w.gm.ctx = new A(); }
      w.gm?.ctx?.resume?.();
      $("[data-start]").hidden = true; $("[data-skip]").hidden = false; $("[data-reset]").hidden = false;
      enter(0);
    });
    $("[data-skip]").addEventListener("click", () => (i + 1 < blocks.length ? enter(i + 1) : finish()));
    $("[data-reset]").addEventListener("click", () => {
      if (timer) clearInterval(timer);
      timer = null; i = -1;
      (window as any).gmStop?.();
      root.classList.remove("done");
      document.querySelectorAll(".block.on").forEach((b) => b.classList.remove("on"));
      $("[data-title]").textContent = `Session · ${total} min`;
      $("[data-sub]").textContent = blocks.map((b) => b.minutes).join(" · ");
      $("[data-clock]").textContent = fmt(blocks[0].minutes * 60);
      $("[data-bar]").style.width = "0";
      $("[data-start]").hidden = false; $("[data-skip]").hidden = true; $("[data-reset]").hidden = true;
    });
  }
</script>
