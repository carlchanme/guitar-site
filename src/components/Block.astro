---
// One practice block. id pairs with the Session runner's block list.
const { id, title, minutes, node } = Astro.props;
---
<section class="block" id={"block-" + id}>
  <header>
    <h2>{title}</h2>
    <span class="meta">{minutes} min{node && <> · node {node}</>}</span>
  </header>
  <slot />
</section>

<style>
  .block{margin:22px 0 0;padding:6px 0 18px;border-top:1px solid var(--rule);scroll-margin-top:118px}
  .block header{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
  .block h2{margin:8px 0 2px}
  .meta{font-size:13px;color:var(--muted);white-space:nowrap}
  .block.on{border-top-color:var(--root)}
  .block.on h2::before{content:"▶ ";color:var(--root);font-size:14px}
</style>
