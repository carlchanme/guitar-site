---
// Countdown for one exercise. Starts the page's metronome preset (if any)
// and beeps three times at zero. nextHref lights up when done.
// Start is the one primary action on the exercise page; when the block is
// done the accent moves to the Next link so there is still only one.
// The ring left of the digits is the elapsed-time report: --ink-soft while
// it runs, --accent at zero (the "done" status mark). DESIGN.md → Timer.
import Card from "./Card.astro";
import Action from "./Action.astro";
const { minutes, nextHref = null, nextTitle = null } = Astro.props;
---
<Card data-xt data-min={minutes} data-next={nextHref || ""}>
  <div class="xt">
    <svg class="ring" viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
      <circle cx="28" cy="28" r="26" fill="none" stroke="var(--line)" stroke-width="2"/>
      <circle cx="28" cy="28" r="26" fill="none" stroke="var(--ink-soft)" stroke-width="2" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 28 28)" data-ring/>
    </svg>
    <div class="clock" data-clock role="timer" aria-live="off">{String(minutes).padStart(2, "0")}:00</div>
    <div class="ctl">
      <Action variant="primary" data-go>Start {minutes}&nbsp;min</Action>
      {nextHref && <Action href={nextHref} data-next-link>Next: {nextTitle}</Action>}
    </div>
  </div>
</Card>
<style>
  .xt{display:grid;grid-template-columns:auto auto 1fr;gap:8px 16px;align-items:center}
  .ring{display:block;width:56px;height:56px}
  .ring [data-ring]{transition:stroke-dashoffset .25s linear}
  .done .ring [data-ring]{stroke:var(--accent)}
  .clock{font-family:var(--mono);font-size:var(--t-xl);line-height:1;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-0.01em}
  .ctl{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
</style>
<script>
  // Bound once per element, on first load and after every client-side swap.
  // A running countdown is cleared before the page it belongs to is swapped out.
  const live = new Set<() => void>();
  function bind() {
    for (const el of document.querySelectorAll<HTMLElement>("[data-xt]")) {
      if (el.dataset.bound !== undefined) continue;
      el.dataset.bound = "";
      const total = Number(el.dataset.min) * 60;
      const clock = el.querySelector<HTMLElement>("[data-clock]")!, ring = el.querySelector<SVGCircleElement>("[data-ring]")!, go = el.querySelector<HTMLButtonElement>("[data-go]")!;
      const next = el.querySelector<HTMLElement>("[data-next-link]");
      // One primary per screen: when the block is done the accent moves to Next.
      const setDone = (done: boolean) => { el.classList.toggle("done", done); go.classList.toggle("primary", !done); next?.classList.toggle("primary", done); };
      let endAt = 0, timer: number | null = null;
      const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
      const w = window as any;
      // Audio context: the metronome's if it exists on this page, else our own.
      function ctx(): AudioContext | null {
        const A = w.AudioContext || w.webkitAudioContext; if (!A) return null;
        if (w.gm) { w.gm.ctx ??= new A(); return w.gm.ctx; }
        return (w._xtctx ??= new A());
      }
      function beep(n: number) {
        const c = ctx(); if (!c) return;
        for (let k = 0; k < n; k++) {
          const t = c.currentTime + k * 0.18, o = c.createOscillator(), g = c.createGain();
          o.frequency.value = 660; g.gain.setValueAtTime(0.6, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
          o.connect(g).connect(c.destination); o.start(t); o.stop(t + 0.16);
        }
      }
      function stop() { if (timer) clearInterval(timer); timer = null; live.delete(stop); w.gmStop?.(); go.textContent = `Start ${Number(el.dataset.min)} min`; }
      go.addEventListener("click", () => {
        if (timer) return stop();
        const m = document.querySelector<HTMLElement>("[data-metronome]");
        if (m) w.gmPreset?.(m, Number(m.dataset.bpm), Number(m.dataset.subdiv), true);
        else ctx()?.resume?.();
        setDone(false);
        endAt = Date.now() + total * 1000;
        go.textContent = "Stop";
        live.add(stop);
        timer = window.setInterval(() => {
          const left = Math.max(0, Math.round((endAt - Date.now()) / 1000));
          clock.textContent = fmt(left);
          ring.style.strokeDashoffset = String((left / total) * 100);
          if (left === 0) { beep(3); stop(); setDone(true); }
        }, 250);
      });
    }
  }
  bind();
  document.addEventListener("astro:page-load", bind);
  document.addEventListener("astro:before-swap", () => live.forEach((stop) => stop()));
</script>

