---
import { exHref } from "../lib/course.js";
const { day, active } = Astro.props;
const hasLesson = day.exercises[0]?.kind === "lesson";
---
<nav class="stepper" aria-label="exercises">
  {day.exercises.map((ex, i) => (
    <a href={exHref(day, ex)} class={(ex.id === active ? "on " : "") + ex.status}>
      {ex.status === "done" && <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent)"/><path d="M4.8 8.3l2 2 4.2-4.4" fill="none" stroke="var(--accent-ink)" stroke-width="1.8" stroke-linecap="round"/></svg>}
      <span>{ex.kind === "lesson" ? "Lesson" : `Exercise ${hasLesson ? i : i + 1}`}</span>
      <small>{ex.kind === "lesson" ? "Overview" : ex.title}</small>
    </a>
  ))}
</nav>
<script>
  document.querySelector(".stepper a.on")?.scrollIntoView({ inline: "center", block: "nearest" });
</script>
<style>
  .stepper{display:flex;overflow-x:auto;border-bottom:1px solid var(--line);margin:16px 0 0;scrollbar-width:none}
  .stepper::-webkit-scrollbar{display:none}
  .stepper a{flex:1 0 auto;display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:10px 16px 12px 0;margin-right:16px;text-decoration:none;color:var(--ink-soft);font-size:var(--t-xs);border-bottom:1px solid transparent;margin-bottom:-1px;white-space:nowrap;min-width:96px;transition:opacity 150ms}
  .stepper a:hover{opacity:.8}
  .stepper a span{display:flex;align-items:center;gap:6px;font-weight:700}
  .stepper a small{font-size:11px;color:var(--ink-faint)}
  .stepper a.on{color:var(--ink);border-bottom-color:var(--ink);opacity:1}
  .stepper a.on small{color:var(--ink-soft)}
  .stepper a.done{color:var(--ink)}
</style>
