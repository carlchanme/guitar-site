---
// App shell: rail · sidebar (pathway) · main. Sidebar is a drawer under 900px.
import Head from "../components/Head.astro";
import Sidebar from "../components/Sidebar.astro";
const { title, description = "", activeDay = null } = Astro.props;
const path = Astro.url.pathname;
const rail = [
  ["/path/", "Path", "M6 4h12v16l-6-4-6 4z", ["/path", "/day"]],
  ["/progress/", "Progress", "M4 20V10m6 10V4m6 16v-7m6 7v-4", ["/progress"]],
  ["/log/", "Log", "M5 4h14v16H5zM8 9h8M8 13h8M8 17h5", ["/log"]],
  ["/metronome/", "Metronome", "M12 3l6 17H6zM12 12l4-6", ["/metronome"]],
  ["/library/", "Library", "M4 5h6v14H4zM14 5h6v14h-6z", ["/library", "/lesson", "/reference"]],
];
const on = (prefixes) => prefixes.some((p) => path.startsWith(p));
---
<!doctype html>
<html lang="en">
<head>
<Head title={title} description={description} />
<style is:global>
  .app{display:grid;grid-template-columns:72px 320px 1fr;min-height:100dvh}
  .rail{background:var(--surface);border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;padding:20px 0;gap:4px;position:sticky;top:0;height:100dvh}
  .rail .mark{font-family:var(--display);font-variation-settings:"SOFT" 50,"WONK" 0;font-size:var(--t-md);letter-spacing:var(--track-tight);text-decoration:none;color:var(--ink);writing-mode:vertical-rl;transform:rotate(180deg);margin-bottom:28px;padding:4px 0}
  .rail .mark:hover{opacity:.8}
  .rail a.item{width:60px;padding:8px 0 6px;border-radius:var(--radius);display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--ink-soft);text-decoration:none;font-size:11px;line-height:1;transition:opacity 150ms}
  .rail a.item:hover{opacity:.8}
  .rail a.item.on{color:var(--ink);background:var(--card);opacity:1}
  .rail svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .side{position:sticky;top:0;height:100dvh;overscroll-behavior:contain}
  .scrim{display:none}
  main{padding:24px max(40px, env(safe-area-inset-right)) 96px 40px;min-width:0;overflow-x:hidden}
  .main-inner{max-width:760px}
  .topbar{display:none}
  @media (max-width:1200px){
    .app{grid-template-columns:72px 280px 1fr}
    main{padding:24px 32px 96px}
  }
  @media (max-width:900px){
    .app{grid-template-columns:1fr}
    .rail{display:none}
    .side{position:fixed;inset:0 20% 0 0;z-index:30;height:100dvh;transform:translateX(-100%);transition:transform .2s}
    .side.open{transform:none}
    .scrim{position:fixed;inset:0;z-index:29;background:var(--scrim);opacity:0;pointer-events:none;transition:opacity .2s}
    .side.open + .scrim{display:block;opacity:1;pointer-events:auto}
    .scrim{display:block}
    .topbar{display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 16px;margin:0 -16px 8px}
    .topbar button{min-height:36px;padding:6px 12px;font-size:var(--t-xs)}
    .topbar nav{display:flex;gap:16px;font-size:var(--t-xs);overflow-x:auto;scrollbar-width:none}
    .topbar nav a{text-decoration:none;color:var(--ink-soft);white-space:nowrap}
    .topbar nav a.on{color:var(--ink);font-weight:700}
    main{padding:0 32px 80px}
    .topbar{padding:10px 32px;margin:0 -32px 8px}
  }
  @media (max-width:600px){
    main{padding:0 max(16px, env(safe-area-inset-right)) 80px max(16px, env(safe-area-inset-left))}
    .topbar{padding:10px 16px;margin:0 -16px 8px}
    h1{font-size:var(--t-lg)}
  }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="app">
  <nav class="rail" aria-label="sections">
    <a href="/" class="mark" aria-label="home">Back seat to lead</a>
    {rail.map(([href, label, d, pre]) => <a href={href} class={"item" + (on(pre) ? " on" : "")} aria-label={label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d}/></svg><span>{label}</span></a>)}
  </nav>
  <Sidebar activeDay={activeDay} />
  <div class="scrim" aria-hidden="true"></div>
  <main id="main" tabindex="-1">
    <div class="topbar">
      <button id="menu" aria-controls="side" aria-expanded="false">Days</button>
      <nav>{rail.map(([href, label, , pre]) => <a href={href} class={on(pre) ? "on" : ""}>{label}</a>)}</nav>
    </div>
    <div class="main-inner"><slot /></div>
  </main>
</div>
<script>
  const side = document.getElementById("side")!;
  const menu = document.getElementById("menu")!;
  const setOpen = (open: boolean) => {
    side.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
  };
  menu.addEventListener("click", () => setOpen(!side.classList.contains("open")));
  side.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("click", (e) => {
    if (side.classList.contains("open") && !side.contains(e.target as Node) && e.target !== menu) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && side.classList.contains("open")) { setOpen(false); menu.focus(); }
  });
</script>
</body>
</html>
