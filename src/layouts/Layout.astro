---
const { title, description = "" } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ["/", "Home"],
  ["/drills/", "Drills"],
  ["/metronome/", "Metronome"],
  ["/log/", "Log"],
  ["/progress/", "Progress"],
  ["/reference/", "Reference"],
];
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#dcd8cc" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<style is:global>
  :root{
    --bg:#dcd8cc; --ink:#22201c; --muted:#6b665c; --rule:#b7b1a4; --card:#e8e4d9;
    --board:#3a2418; --fret:#b8ad98; --string:#e9e3d3;
    --root:#c8781c; --tone:#f3ecd8; --ok:#4f7a4a; --warn:#b0522f;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--ink);
    font:17px/1.55 Georgia,"Iowan Old Style","Palatino Linotype",Palatino,serif;
    padding-bottom:env(safe-area-inset-bottom)}
  main{max-width:640px;margin:0 auto;padding:6px 16px 60px}
  h1{font-size:26px;line-height:1.2;margin:8px 0 8px;font-weight:600}
  h2{font-size:20px;margin:28px 0 6px;font-weight:600}
  h3{font-size:17px;margin:18px 0 4px;font-weight:600}
  p{margin:10px 0;max-width:64ch}
  a{color:var(--ink)}
  ol,ul{padding-left:22px}
  li{margin:4px 0}
  table{border-collapse:collapse;width:100%;font-size:15px;margin:10px 0}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--rule);vertical-align:top}
  th{color:var(--muted);font-weight:600}
  code{font:15px/1.4 ui-monospace,Menlo,monospace;background:var(--card);padding:1px 5px;border-radius:3px}
  nav.top{max-width:640px;margin:0 auto;padding:14px 16px 0;font-size:15px;
    display:flex;flex-wrap:wrap;gap:4px 14px}
  nav.top a{color:var(--muted);text-decoration:none;padding:4px 0}
  nav.top a.on{color:var(--ink);border-bottom:2px solid var(--root)}
  .board{width:100%;height:auto;display:block;margin:12px 0;border-radius:6px}
  .lesson-nav{display:flex;justify-content:space-between;margin-top:36px;
    padding-top:16px;border-top:1px solid var(--rule);font-size:15px}
  .note{border-left:3px solid var(--root);padding:2px 0 2px 14px;margin:14px 0}
  .muted{color:var(--muted)}
  .small{font-size:14px}
  button{font:inherit;color:var(--ink);background:var(--card);border:1px solid #9c968a;
    border-radius:8px;padding:10px 14px;min-height:48px;cursor:pointer;touch-action:manipulation}
  button:active{background:#d5d0c3}
  button.primary{background:var(--root);color:#fff;border-color:#a35f12;font-weight:600}
  footer{max-width:640px;margin:40px auto 0;padding:0 16px;font-size:13px;color:var(--muted)}
</style>
</head>
<body>
<nav class="top">{links.map(([href, label]) => <a href={href} class={isActive(href) ? "on" : ""}>{label}</a>)}</nav>
<main><slot /></main>
<footer>I play guitar at my church. This site is notes to myself, shared in case they help someone else.</footer>
</body>
</html>
