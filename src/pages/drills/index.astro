---
import Layout from "../../layouts/Layout.astro";
import roadmap from "../../data/roadmap.json";
const drills = [
  { slug: "week-01", title: "Week 1 — Clean hands", dates: "21–27 Sep", phase: "Clean hands" },
];
---
<Layout title="Drills" description="One drill plan per week. Timer, metronome and diagrams on the page.">
  <h1>Drills</h1>
  <p>One plan per week. Open it on the phone, press start, play. The timer runs the blocks and sets the metronome.</p>
  <ul class="list">
    {drills.map((d) => <li><a href={`/drills/${d.slug}/`}>{d.title}</a><span class="muted small"> · {d.dates}</span></li>)}
  </ul>
  <h2>Phases to {roadmap.target.slice(8)} Dec</h2>
  <table>
    <thead><tr><th>Weeks</th><th>Phase</th><th>Sunday-visible result</th></tr></thead>
    <tbody>{roadmap.phases.map((p) => <tr><td>{p.weeks}</td><td>{p.name}</td><td>{p.outcome}</td></tr>)}</tbody>
  </table>
</Layout>
<style>.list{list-style:none;padding:0}.list li{padding:8px 0;border-bottom:1px solid var(--rule)}</style>
