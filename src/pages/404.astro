---
import App from "../layouts/App.astro";
import Action from "../components/Action.astro";
---
<App title="Not found" description="That page is not on the path.">
  <p class="crumb">404</p>
  <h1>Not on the path.</h1>
  <p>There is no page at this address. It may have moved when the pathway did, or the day is not written yet.</p>
  <p><Action href="/path/">Open the pathway</Action></p>
</App>
