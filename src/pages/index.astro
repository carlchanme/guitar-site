---
import App from "../layouts/App.astro";
import StatusIcon from "../components/StatusIcon.astro";
import { pathway, phases, pathwayProgress, phaseProgress, currentDay, dayHref, dayProgress } from "../lib/course.js";
const total = pathwayProgress();
const cur = currentDay();
const cp = dayProgress(cur);
---
<App title={pathway.title} description={pathway.intro}>
  <p class="crumb">{pathway.subtitle}</p>
  <h1>{pathway.title}</h1>
  <p>{pathway.intro}</p>

  <a class="continue" href={dayHref(cur)}>
    <div>
      <span class="small muted">Continue</span>
      <strong>Day {cur.day}. {cur.title}</strong>
      <span class="small muted">{cur.phase.title} · {cp.done}/{cp.total} exercises done</span>
    </div>
    <StatusIcon status="current" size={32} />
  </a>

  <div class="stat">
    <div><b>{total.done}</b><span>of {total.total} days</span></div>
    <div><b>{phases.filter((p) => p.status === "done").length}</b><span>of {phases.length} phases</span></div>
    <div><b>{pathway.end.slice(8)} Dec</b><span>target</span></div>
  </div>

  <h2>Phases</h2>
  {phases.map((p) => { const pp = phaseProgress(p); return (
    <div class={"phase " + p.status}>
      <div class="ph">
        <div><b>{p.name} · {p.title}</b><span class="small muted">{p.weeks} · {pp.done}/{pp.total} days</span></div>
        <StatusIcon status={p.status} />
      </div>
      <i class="bar"><b style={`width:${pp.pct}%`}></b></i>
      <p class="small">{p.outcome}</p>
      {p.days.length > 0 && <p class="small"><a href={dayHref(p.days[0])}>Open day {p.days[0].day} →</a></p>}
    </div>
  ); })}
</App>
<style>
  .continue{display:flex;justify-content:space-between;align-items:center;gap:14px;background:var(--card);border:1px solid var(--accent);border-radius:14px;padding:16px 18px;text-decoration:none;margin:18px 0}
  .continue strong{display:block;font-size:20px;margin:2px 0}
  .continue span{display:block}
  .stat{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
  .stat div{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px}
  .stat b{display:block;font-size:26px;line-height:1.1}
  .stat span{font-size:13px;color:var(--muted)}
  .phase{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:10px 0}
  .phase.locked{opacity:.7}
  .ph{display:flex;justify-content:space-between;align-items:center}
  .ph b{display:block}
  .ph span{display:block}
  .bar{display:block;height:3px;background:var(--line);border-radius:2px;margin:8px 0 4px}
  .bar b{display:block;height:100%;background:var(--accent);border-radius:2px}
</style>
